# AgriAI 360 backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Database
# Local dev default (no Postgres server required): sqlite:///./agriai.db
# Production / when PostgreSQL is available:
#   postgresql://<user>:<password>@<host>:5432/agriai360
DATABASE_URL=sqlite:///./agriai.db

# JWT auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Weather: WEATHER_PROVIDER=mock (default) uses the built-in deterministic mock
# provider. Set WEATHER_PROVIDER=open-meteo for real, live weather + a 5-day
# forecast via open-meteo.com — it's free and requires NO API key, so
# WEATHER_API_KEY can stay blank even with open-meteo selected. WEATHER_API_KEY
# is reserved for a future key-requiring provider (e.g. OpenWeatherMap), not
# used by open-meteo.
WEATHER_API_KEY=
WEATHER_PROVIDER=mock

# Satellite / NDVI (planned integration — no provider is implemented yet;
# leaving this blank keeps the Satellite module in its "planned/integration-ready" state)
SATELLITE_API_KEY=
SATELLITE_PROVIDER=none

# ML model artifacts directory (relative to backend/ or absolute)
MODELS_DIR=../models
